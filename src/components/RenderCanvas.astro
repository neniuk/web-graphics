---

<canvas id="canvas-screen" class="fixed top-0 left-0 w-full h-full"></canvas>

<script>
	import { Renderer } from "../utils/renderer";
	import type { Model } from "../utils/renderer";
	import { AppState } from "../utils/appState";
	import type { RayTracerState } from "../utils/rayTracerState";
	import { SceneParser } from "../utils/sceneParser";
	import { triangleLikeObjectsToModel } from "../utils/modelAdapters";

	const ANGULAR_VELOCITY = Math.PI * 0.5;
	const ANIMATE_RASTERIZER = true;

	let renderer: Renderer | null = null;

	const canvas = document.getElementById("canvas-screen") as HTMLCanvasElement | null;
	if (canvas) {
		const resizeCanvas = () => {
			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;
			renderer?.resize(canvas.width, canvas.height);
		};

		resizeCanvas();

		const ctx: CanvasRenderingContext2D | null = canvas.getContext("2d");
		if (ctx) {
			ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
			ctx.fillStyle = "rgb(0 0 0)";
			ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

			const stateRes = await fetch("/states/state.json");
			const stateJson = await stateRes.json();
			const state = new AppState<RayTracerState>(stateJson);

			const parser = new SceneParser(state.data.scenePath, null, canvas.width, canvas.height);

			await parser.loadGltf();
			const scene = parser.buildScene();
			console.log("objects:", scene.objects.length);
			const model: Model = triangleLikeObjectsToModel(scene.objects);
			console.log("rasterizer model:", model.vertices.length, "vertices,", model.faces.length, "faces");

			if (model.faces.length === 0) {
				throw new Error("No triangle faces were loaded for the rasterizer");
			}

			renderer = new Renderer(scene.camera, ctx);
			renderer.resize(canvas.width, canvas.height);

			let lastTimestamp = performance.now();
			const renderFrame = (timestamp: number, rotate: boolean = ANIMATE_RASTERIZER) => {
				const dt = Math.min((timestamp - lastTimestamp) / 1000, 0.1);
				lastTimestamp = timestamp;

				if (!renderer) return;

				renderer.clear();
				if (rotate) {
					renderer.rotateY(ANGULAR_VELOCITY * dt);
				}
				renderer.drawTriangleMesh(model);

				if (ANIMATE_RASTERIZER) {
					requestAnimationFrame(renderFrame);
				}
			};

			renderFrame(performance.now());

			window.addEventListener("resize", () => {
				resizeCanvas();
				if (!ANIMATE_RASTERIZER) {
					renderFrame(performance.now(), false);
				}
			});
		}
	}
</script>
